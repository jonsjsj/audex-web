# ── Audiobookshelf — your library + progress source of truth ──────────────
ABS_URL=http://192.168.68.250:13378

# ── Codex — sync parity (progress pushes to its webhook from Phase 3 on).
# Just the instance URL: each signed-in person links their OWN Codex API
# token from Settings in the app itself (Codex → Settings → API Keys), the
# same as the mobile app — not set here. ──
CODEX_URL=https://codex.bellaybestia.no

# ── Session + credential encryption — set a real random value, keep it secret ──
SECRET_KEY=change-me-to-a-long-random-string
AUDEX_WEB_PORT=8420
SESSION_COOKIE_SECURE=true

# ── SSO (Authentik) — leave blank to disable and use ABS-credential sign-in only ──
OIDC_ISSUER=https://auth.bellaybestia.no/application/o/audexweb/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://audexweb.bellaybestia.no/api/auth/oidc/callback
# LAN-direct base so server-to-IdP calls don't round-trip the public proxy.
OIDC_INTERNAL_BASE=http://192.168.68.250:9000
